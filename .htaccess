# El servidor web debe apuntar a la carpeta public/ (DocumentRoot).
# Este archivo es solo un respaldo por si se publica la raíz del proyecto
# (por ejemplo en XAMPP o en un hosting compartido).

# Ningún archivo oculto (.env, .git, .gitignore...) se entrega al navegador.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Todas las peticiones se atienden desde public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Sin mod_rewrite no hay forma segura de servir la raíz: se bloquea todo.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
